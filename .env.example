# MySQL Database Configuration Example
# Copy this file to '.env' and update the values with your local MySQL setup.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=library

# Default Initial Administrator Credentials (used during initial database setup)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=your_admin_password_here
DEFAULT_ADMIN_NAME=System Administrator
